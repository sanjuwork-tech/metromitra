// MetroMitra Prisma schema
// Database: SQLite for local/dev. Portable to Turso (libSQL) or Postgres
// by changing the `provider` and `DATABASE_URL` only — no schema changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────────────────────
// Users & auth
// ───────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  // Profile
  avatarUrl     String?
  bio           String?
  homeStationId String?
  workStationId String?
  travelWindow  String? // e.g. "08:00-10:00, 18:00-20:00"
  preferredLang String   @default("en")
  city          String?
  // Trust
  trustScore    Int      @default(0)
  verifiedBadge Boolean  @default(false)
  // Roles
  role          String   @default("member") // member | moderator
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  homeStation   Station? @relation("UserHomeStation", fields: [homeStationId], references: [id])
  workStation   Station? @relation("UserWorkStation", fields: [workStationId], references: [id])

  posts          Post[]
  replies        Reply[]
  carpools       Carpool[]       @relation("CarpoolAuthor")
  carpoolJoins   CarpoolJoin[]
  buddyRequests  BuddyRequest[]
  lostFound      LostFound[]
  marketplace    Marketplace[]
  ratingsGiven   Rating[]        @relation("RatingRater")
  ratingsReceived Rating[]       @relation("RatingRated")
  reportsMade    Report[]        @relation("ReportReporter")
  reportsAgainst Report[]        @relation("ReportSubject")
  contactsInit   ContactRequest[] @relation("ContactInitiator")
  contactsRecv   ContactRequest[] @relation("ContactRecipient")

  @@index([city])
  @@index([homeStationId])
}

// ───────────────────────────────────────────────────────────────
// Stations (seeded static data for Indian metros)
// ───────────────────────────────────────────────────────────────

model Station {
  id        String   @id @default(cuid())
  code      String   @unique // e.g. RJC, CSB, AND
  name      String   // e.g. Rajiv Chowk
  city      String   // Delhi, Mumbai, Bengaluru, Hyderabad, Chennai, Kolkata
  lines     String   // comma-separated line names, e.g. "Blue,Yellow"
  lineColors String  // comma-separated hex/role names, e.g. "blue,yellow"
  exitCount Int?
  createdAt DateTime @default(now())

  // Relations
  homeUsers   User[]          @relation("UserHomeStation")
  workUsers   User[]          @relation("UserWorkStation")
  posts       Post[]
  carpools    Carpool[]
  buddyOrigins  BuddyRequest[] @relation("BuddyOrigin")
  buddyDestinations BuddyRequest[] @relation("BuddyDest")
  lostFound   LostFound[]
  marketplace Marketplace[]

  @@index([city])
  @@index([name])
}

// ───────────────────────────────────────────────────────────────
// Community feed
// ───────────────────────────────────────────────────────────────

model Post {
  id         String   @id @default(cuid())
  authorId   String
  stationId  String? // null = global feed
  body       String
  tag        String   @default("general") // help, info, alert, meetup, general
  imageUrl   String?
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  station    Station? @relation(fields: [stationId], references: [id])
  replies    Reply[]

  @@index([stationId, createdAt])
  @@index([createdAt])
}

model Reply {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String
  isAnswer  Boolean  @default(false)
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

// ───────────────────────────────────────────────────────────────
// Carpool / last-mile ride share
// ───────────────────────────────────────────────────────────────

model Carpool {
  id              String   @id @default(cuid())
  authorId        String
  type            String   // offer | request
  originStationId String
  destinationArea String   // free-text, e.g. "Indiranagar 100ft Road"
  departAt        DateTime
  seats           Int      @default(1)
  mode            String   // auto | cab | personal
  costSplit       String   @default("share") // share | fixed | free
  womenOnly       Boolean  @default(false)
  notes           String?
  status          String   @default("open") // open, matched, completed, expired
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  author          User     @relation("CarpoolAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  originStation   Station  @relation(fields: [originStationId], references: [id])
  joins           CarpoolJoin[]

  @@index([originStationId, status, departAt])
  @@index([status])
}

model CarpoolJoin {
  id        String   @id @default(cuid())
  carpoolId String
  userId    String
  message   String?
  status    String   @default("pending") // pending, accepted, declined
  createdAt DateTime @default(now())

  carpool   Carpool  @relation(fields: [carpoolId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([carpoolId, userId])
  @@index([userId])
}

// ───────────────────────────────────────────────────────────────
// Travel buddy finder
// ───────────────────────────────────────────────────────────────

model BuddyRequest {
  id              String   @id @default(cuid())
  userId          String
  originStationId String
  destStationId   String?
  travelAt        DateTime
  womenOnly       Boolean  @default(false)
  notes           String?
  status          String   @default("open") // open, matched, completed, expired
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originStation   Station  @relation("BuddyOrigin", fields: [originStationId], references: [id])
  destStation     Station? @relation("BuddyDest", fields: [destStationId], references: [id])

  @@index([originStationId, status, travelAt])
  @@index([status])
}

// ───────────────────────────────────────────────────────────────
// Lost & Found
// ───────────────────────────────────────────────────────────────

model LostFound {
  id          String   @id @default(cuid())
  userId      String
  type        String   // lost | found
  category    String   // wallet, phone, keys, bag, id, electronics, other
  title       String
  description String
  stationId   String
  eventDate   DateTime
  status      String   @default("active") // active, reunited, closed
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  station     Station  @relation(fields: [stationId], references: [id])

  @@index([stationId, type, status])
  @@index([status])
}

// ───────────────────────────────────────────────────────────────
// Marketplace
// ───────────────────────────────────────────────────────────────

model Marketplace {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String
  price       Int      // INR
  category    String   // books, electronics, furniture, household, tickets, other
  condition   String   @default("good") // new, good, fair
  stationId   String
  imageUrl    String?
  status      String   @default("available") // available, reserved, sold
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  station     Station  @relation(fields: [stationId], references: [id])

  @@index([stationId, category, status])
  @@index([status])
}

// ───────────────────────────────────────────────────────────────
// Contact requests (carpool, lost-found, marketplace)
// ───────────────────────────────────────────────────────────────

model ContactRequest {
  id           String   @id @default(cuid())
  initiatorId  String
  recipientId  String
  contextType  String   // carpool, lost_found, marketplace, buddy
  contextId    String
  message      String?
  status       String   @default("pending") // pending, accepted, declined
  createdAt    DateTime @default(now())

  initiator    User     @relation("ContactInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  recipient    User     @relation("ContactRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, status])
  @@index([initiatorId])
}

// ───────────────────────────────────────────────────────────────
// Ratings & reports
// ───────────────────────────────────────────────────────────────

model Rating {
  id         String   @id @default(cuid())
  raterId    String
  ratedId    String
  contextType String  // carpool, buddy, marketplace
  contextId  String
  score      Int      // 1..5
  note       String?
  createdAt  DateTime @default(now())

  rater      User     @relation("RatingRater", fields: [raterId], references: [id], onDelete: Cascade)
  rated      User     @relation("RatingRated", fields: [ratedId], references: [id], onDelete: Cascade)

  @@unique([raterId, ratedId, contextType, contextId])
  @@index([ratedId])
}

model Report {
  id          String   @id @default(cuid())
  reporterId  String
  subjectId   String   // the user being reported
  targetType  String   // post, reply, carpool, buddy, lost_found, marketplace, user
  targetId    String
  reason      String
  status      String   @default("open") // open, reviewed, dismissed, actioned
  createdAt   DateTime @default(now())

  reporter    User     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  subject     User     @relation("ReportSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([status])
}
