# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log

# Skills directory (vendored reference material, not application source)
/skills/

# SQLite database file (local dev only)
db/*.db
db/*.db-journal

# Bun lockfile (npm is the package manager of record for Vercel)
bun.lock
bun.lockb

# Playbook reference uploads (kept under docs/reference/ which IS committed)
/upload/

# Tool result scratch
/tool-results/

# Download scratch
/download/

# Tests scratch (non-application)
/tests/